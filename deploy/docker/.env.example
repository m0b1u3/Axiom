# 复制到 deploy/docker/.env 并按需修改
POSTGRES_DB=axiom
POSTGRES_USER=axiom
POSTGRES_PASSWORD=axiom

# Explicit release tags keep upgrades and rollback images separate.
AXIOM_IMAGE_PREFIX=axiom-local
AXIOM_RELEASE=local
# Optional Web-only release; leave empty to follow AXIOM_RELEASE.
AXIOM_WEB_RELEASE=
# Host Web port; the static Nginx container listens on 8080.
AXIOM_WEB_PORT=5173

# Server + Agent + Web 的共享配置
AXIOM_ADMIN_PASSWORD=admin
AXIOM_JWT_SECRET=replace-with-long-random-string
AXIOM_AGENT_TOKEN=replace-with-long-random-string

# 1=只走 mock，不消耗模型额度；0=用真实模型
AXIOM_SCAN_MOCK=1

# PostgreSQL 数据源（推荐用本地恢复的 PostgreSQL）
AXIOM_DATABASE_URL=postgres://axiom:axiom@postgres:5432/axiom?sslmode=disable

AXIOM_AGENT_ID=agent-local
AXIOM_MAX_RECOVERIES=0

# 可选：放置 VPS 备份导入文件（解密后）
# AXIOM_DUMP_FILE=axiom.dump
# AXIOM_DUMP_DIR=./backups
# AXIOM_STAGE_DUMP_FILE=axiom_stage.dump
# AXIOM_TEST_DUMP_FILE=axiom_test.dump

# 独立复核输出：native_schema（默认）或 json_object（显式兼容模式）。
# 仅支持经适配器连接的 OpenAI-compatible 上游；不修改扫描输出或自动降级。
AXIOM_VALIDATION_OUTPUT_MODE=native_schema
