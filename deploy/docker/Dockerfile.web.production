FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS build
WORKDIR /workspace/contracts
COPY contracts/package.json contracts/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
WORKDIR /workspace/code-audit-web
COPY code-audit-web/package.json code-audit-web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY contracts/ts/src /workspace/contracts/ts/src
COPY code-audit-web /workspace/code-audit-web
RUN npm run build

FROM nginx:1.30.5-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
ARG AXIOM_BUILD_VERSION=development
LABEL org.opencontainers.image.version=$AXIOM_BUILD_VERSION \
      org.opencontainers.image.source="https://github.com/m0b1u3/Axiom" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY LICENSE NOTICE /usr/share/doc/axiom/
COPY deploy/docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /workspace/code-audit-web/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
