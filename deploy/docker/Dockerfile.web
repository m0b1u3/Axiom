FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
ARG AXIOM_BUILD_VERSION=development
LABEL org.opencontainers.image.version=$AXIOM_BUILD_VERSION \
      org.opencontainers.image.source="https://github.com/m0b1u3/Axiom" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY LICENSE NOTICE /usr/share/doc/axiom/

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1001 axiom
WORKDIR /app

# Runtime contract validation is imported by the Web component-plan surface.
# Install its locked dependencies beside the shared sources for Vite resolution.
COPY contracts/package.json contracts/package-lock.json ./contracts/
RUN cd contracts && npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY code-audit-web/package*.json ./code-audit-web/
RUN cd code-audit-web && npm ci

COPY contracts/ts/src /app/contracts/ts/src
COPY code-audit-web /app/code-audit-web
RUN chown -R axiom:axiom /app/code-audit-web

USER axiom
WORKDIR /app/code-audit-web
ENV XDG_CACHE_HOME=/tmp/.cache \
    VITE_TEMP_DIR=/tmp/.cache/vite

RUN mkdir -p /tmp/.cache/vite /app/code-audit-web/node_modules/.vite-temp && \
    chown -R axiom:axiom /tmp/.cache /app/code-audit-web/node_modules/.vite-temp
