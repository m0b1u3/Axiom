FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1001 axiom
WORKDIR /app

COPY code-audit-web/package*.json ./code-audit-web/
RUN cd code-audit-web && npm ci

COPY contracts/ts/src /app/contracts/ts/src
COPY code-audit-web /app/code-audit-web
RUN chown -R axiom:axiom /app/code-audit-web

USER axiom
WORKDIR /app/code-audit-web
ENV XDG_CACHE_HOME=/tmp/.cache \
    VITE_TEMP_DIR=/tmp/.cache/vite

RUN mkdir -p /tmp/.cache/vite /app/code-audit-web/node_modules/.vite-temp && \
    chown -R axiom:axiom /tmp/.cache /app/code-audit-web/node_modules/.vite-temp
