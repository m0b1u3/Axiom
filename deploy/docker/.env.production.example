# Prefer: python3 deploy/ops/stack.py init /absolute/private/path/production.env
# This example deliberately cannot start with placeholder secrets.
AXIOM_STACK_NAME=axiom-prod
AXIOM_RELEASE=local
AXIOM_IMAGE_PREFIX=axiom
AXIOM_BIND_ADDR=127.0.0.1
AXIOM_WEB_PORT=8088
POSTGRES_DB=axiom
POSTGRES_USER=axiom
POSTGRES_PASSWORD=replace-with-generated-password
AXIOM_DATABASE_URL=postgres://axiom:replace-with-generated-password@postgres:5432/axiom?sslmode=disable
AXIOM_ADMIN_USER=admin
AXIOM_ADMIN_PASSWORD=replace-with-generated-password
AXIOM_JWT_SECRET=replace-with-generated-secret
AXIOM_MASTER_KEY=replace-with-generated-base64url-32-byte-key
AXIOM_AGENT_TOKEN=replace-with-generated-secret
AXIOM_AGENT_ID=agent-local
AXIOM_AGENT_CONCURRENCY=2
AXIOM_MAX_ACTIVE_SCANS=2
AXIOM_MAX_MODEL_SCANS=2
AXIOM_MAX_PROJECT_SCANS=2
# 0=过期后在 Web 决定重试；1–10=允许该次数的自动重新执行（并非续扫）
AXIOM_MAX_RECOVERIES=0
AXIOM_SCAN_MOCK=0

# Optional: original signing secret for old HMAC passwords during key rotation.
# Keep this private until all legacy accounts have migrated on successful login.
AXIOM_LEGACY_PASSWORD_SECRET=
