[Unit]
Description=Axiom bounded concurrent scan agent
After=network.target axiom-server.service
Wants=axiom-server.service

[Service]
Type=simple
WorkingDirectory=/opt/Axiom
EnvironmentFile=/etc/axiom/runtime.env
ExecStart=/opt/Axiom/bin/axiom-agent
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
