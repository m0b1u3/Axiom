{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/contracts/v7/scanner-job.schema.json",
  "title": "ScannerJobV7",
  "$ref": "#/$defs/ScannerJobV7",
  "$defs": {
    "ScannerJobV7": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 7
        },
        "execution": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "source": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/LocalSource"
        },
        "output": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/LocalOutput"
        },
        "model": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ResolvedModel"
        },
        "policy": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ScanPolicy"
        },
        "resultSchemaVersion": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/SchemaVersion"
        },
        "progressSchemaVersion": {
          "type": "integer",
          "const": 2
        },
        "eventSchemaVersion": {
          "type": "integer",
          "const": 2
        },
        "scanInput": {
          "$ref": "https://axiom.invalid/contracts/v1/scan-input.schema.json#/$defs/ScanInput"
        },
        "componentPlanning": {
          "$ref": "https://axiom.invalid/contracts/v1/component-planning.schema.json#/$defs/ComponentPlanningOperation"
        }
      },
      "required": [
        "schemaVersion",
        "execution",
        "source",
        "output",
        "model",
        "policy",
        "resultSchemaVersion",
        "progressSchemaVersion",
        "eventSchemaVersion",
        "scanInput",
        "componentPlanning"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "properties": {
                  "mode": {
                    "const": "standard"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "scanInput": {
                "not": {
                  "required": [
                    "subagents"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "properties": {
                  "mode": {
                    "const": "deep"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "scanInput": {
                "not": {
                  "required": [
                    "validationPrompt"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "properties": {
                  "validation": {
                    "properties": {
                      "mode": {
                        "const": "exploitability"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "scanInput": {
                "not": {
                  "required": [
                    "validationPrompt"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "policy": {
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "standard"
                },
                "includePaths": {
                  "maxItems": 0
                }
              }
            },
            "scanInput": {
              "not": {
                "required": [
                  "subagents"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "scanInput": {
              "maxProperties": 2,
              "properties": {
                "knowledge": {
                  "maxItems": 0
                }
              }
            },
            "policy": {
              "properties": {
                "focus": {
                  "maxItems": 0
                },
                "validation": {
                  "maxProperties": 1,
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "default"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
