{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/contracts/v1/sdk-diagnostics.schema.json",
  "title": "SDKDiagnostics",
  "$ref": "#/$defs/SDKDiagnostics",
  "$defs": {
    "SDKDiagnostics": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "execution": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observerErrorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "omittedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "entries": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "https://axiom.invalid/contracts/v1/sdk-diagnostic.schema.json#/$defs/SDKDiagnostic"
          }
        }
      },
      "required": [
        "schemaVersion",
        "execution",
        "warningCount",
        "observerErrorCount",
        "omittedCount",
        "entries"
      ],
      "additionalProperties": false
    }
  }
}
