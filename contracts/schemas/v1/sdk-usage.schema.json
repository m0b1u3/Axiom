{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/contracts/v1/sdk-usage.schema.json",
  "title": "SDKUsage",
  "$ref": "#/$defs/SDKUsage",
  "$defs": {
    "SDKUsage": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "execution": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "sdkVersion": {
          "type": "string",
          "const": "0.5.0"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "const": "sdk_on_usage"
        },
        "measurement": {
          "type": "string",
          "const": "observed_tokens"
        },
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cachedInputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheWriteInputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoningOutputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "totalTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "componentIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheWriteInputTokensReported": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "execution",
        "sdkVersion",
        "observedAt",
        "source",
        "measurement",
        "inputTokens",
        "cachedInputTokens",
        "cacheWriteInputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "cacheWriteInputTokensReported"
            ],
            "properties": {
              "cacheWriteInputTokensReported": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "cacheWriteInputTokens": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
