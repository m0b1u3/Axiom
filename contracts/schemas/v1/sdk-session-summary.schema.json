{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/contracts/v1/sdk-session-summary.schema.json",
  "title": "SDKSessionSummary",
  "$ref": "#/$defs/SDKSessionSummary",
  "$defs": {
    "SDKSessionSummary": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "execution": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "receivedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "persistedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "omittedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "journal": {
          "anyOf": [
            {
              "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "execution",
        "receivedCount",
        "persistedCount",
        "omittedCount",
        "state",
        "reason",
        "journal"
      ],
      "additionalProperties": false
    }
  }
}
