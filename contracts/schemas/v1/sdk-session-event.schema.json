{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/contracts/v1/sdk-session-event.schema.json",
  "title": "SDKSessionEvent",
  "$ref": "#/$defs/SDKSessionEvent",
  "$defs": {
    "SDKSessionEvent": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "execution": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "occurredAt": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/Timestamp"
        },
        "threadId": {
          "type": "string",
          "maxLength": 512
        },
        "worker": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "event": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/JsonObject"
        },
        "redacted": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "schemaVersion",
        "execution",
        "sequence",
        "occurredAt",
        "threadId",
        "worker",
        "event",
        "redacted"
      ],
      "additionalProperties": false
    }
  }
}
