{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/contracts/v1/deep-resume-definitions.schema.json",
  "$defs": {
    "DeepResumeUsage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cachedInputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheWriteInputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoningOutputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "totalTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "inputTokens",
        "cachedInputTokens",
        "cacheWriteInputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "additionalProperties": false
    },
    "DeepResumeBaseline": {
      "type": "object",
      "properties": {
        "estimatedUsd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254.740992
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "https://axiom.invalid/contracts/v1/deep-resume-definitions.schema.json#/$defs/DeepResumeUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "estimatedUsd",
        "usage"
      ],
      "additionalProperties": false
    },
    "DeepResumeContext": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "execution": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "configurationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "execution",
        "agentId",
        "configurationHash"
      ],
      "additionalProperties": false
    },
    "DeepResumeInspection": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "sdkVersion": {
          "type": "string",
          "const": "0.5.0"
        },
        "execution": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "origin": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "checkedAt": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/Timestamp"
        },
        "eligible": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configurationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scanId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "threadId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "proofHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline": {
          "$ref": "https://axiom.invalid/contracts/v1/deep-resume-definitions.schema.json#/$defs/DeepResumeBaseline"
        }
      },
      "required": [
        "schemaVersion",
        "sdkVersion",
        "execution",
        "origin",
        "agentId",
        "checkedAt",
        "eligible",
        "reason",
        "sourceHash",
        "configurationHash",
        "scanId",
        "threadId",
        "proofHash",
        "baseline"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "eligible": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "scanId": {
                "type": "string",
                "minLength": 1
              },
              "threadId": {
                "type": "string",
                "minLength": 1
              },
              "proofHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "else": {
            "properties": {
              "proofHash": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "DeepResumeProbeClaim": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "leaseToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "execution": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "origin": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "outputPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configurationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "https://axiom.invalid/contracts/v1/sdk-identities.schema.json#/$defs/SDKIdentityRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "leaseToken",
        "execution",
        "origin",
        "agentId",
        "sourcePath",
        "outputPath",
        "sourceHash",
        "configurationHash",
        "model",
        "identity"
      ],
      "additionalProperties": false
    },
    "DeepResumeProbeReport": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "leaseToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "inspection": {
          "$ref": "https://axiom.invalid/contracts/v1/deep-resume-definitions.schema.json#/$defs/DeepResumeInspection"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "leaseToken",
        "agentId",
        "inspection"
      ],
      "additionalProperties": false
    },
    "DeepResumeAssignment": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "execution": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "previous": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "inspection": {
          "$ref": "https://axiom.invalid/contracts/v1/deep-resume-definitions.schema.json#/$defs/DeepResumeInspection"
        }
      },
      "required": [
        "schemaVersion",
        "execution",
        "previous",
        "inspection"
      ],
      "additionalProperties": false
    },
    "DeepResumeAction": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "execution": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "probeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "proofHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "acknowledgeAdditionalCost": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "schemaVersion",
        "execution",
        "probeId",
        "proofHash",
        "acknowledgeAdditionalCost"
      ],
      "additionalProperties": false
    },
    "DeepResumeSnapshot": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "execution": {
          "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/ExecutionRef"
        },
        "state": {
          "type": "string",
          "enum": [
            "unsupported",
            "idle",
            "queued",
            "checking",
            "ready",
            "blocked",
            "pending",
            "running",
            "used"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "probeId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "canCheck": {
          "type": "boolean"
        },
        "canResume": {
          "type": "boolean"
        },
        "inspection": {
          "anyOf": [
            {
              "$ref": "https://axiom.invalid/contracts/v1/deep-resume-definitions.schema.json#/$defs/DeepResumeInspection"
            },
            {
              "type": "null"
            }
          ]
        },
        "continuation": {
          "anyOf": [
            {
              "$ref": "https://axiom.invalid/contracts/v1/deep-resume-definitions.schema.json#/$defs/DeepResumeAssignment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "execution",
        "state",
        "reason",
        "probeId",
        "canCheck",
        "canResume",
        "inspection",
        "continuation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "canResume": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "ready"
              },
              "probeId": {
                "type": "string",
                "minLength": 1
              },
              "inspection": {
                "type": "object",
                "properties": {
                  "eligible": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
