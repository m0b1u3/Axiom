        "event": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "uniqueItems": true
        },
        "result": {
          "type": "array",
          "items": {
            "$ref": "https://axiom.invalid/contracts/v1/definitions.schema.json#/$defs/SchemaVersion"
          },
          "uniqueItems": true
        },
        "completion": {
          "type": "array",
