                    2,
                    3,
                    4,
                    5,
                    6,
                    7,
                    8
                  ]
                },
                "progress": {
                  "const": [
                    2
                  ]
                },
                "event": {
                  "const": [
                    2
                  ]
                },
                "result": {
                  "const": [
                    1
                  ]
                },
                "completion": {
                  "const": [
                    1
                  ]
                }
              }
            }
          }
        }
