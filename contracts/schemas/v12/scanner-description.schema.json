      "required": [
        "schemaVersion",
        "name",
        "version",
        "baselineVersions",
        "runtime",
        "capabilities",
        "configuredSdk",
        "sdkIdentityVersion",
        "sdkParametersVersion",
        "sdkConcurrencyVersion"
      ],
      "additionalProperties": false
    }
